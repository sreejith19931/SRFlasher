<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Color Palette (Original) -->
    <SolidColorBrush x:Key="ActionBlue" Color="#00ADB5"/>
    <SolidColorBrush x:Key="BorderMedium" Color="#3F4756"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#252A37"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="LogErrorBrush" Color="#FF7A6B"/>
    <SolidColorBrush x:Key="LogWarningBrush" Color="#FFB57C"/>
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#33E1B0"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B2BEC3"/>
    <SolidColorBrush x:Key="ControlInputBg" Color="#181B24"/>
    <SolidColorBrush x:Key="SuccessMint" Color="#00B894"/>
    <SolidColorBrush x:Key="WarningAmber" Color="#E17055"/>

    <!-- S1 design tokens: crimson accent + semantic green/red -->
    <SolidColorBrush x:Key="AccentRed" Color="#E0244A"/>
    <!-- Active-tab underline default (falls back to the theme red;
         each tab may override in its own Resources) -->
    <SolidColorBrush x:Key="TabAccentBrush" Color="#E0244A"/>
    <Color x:Key="TabAccentColor">#E0244A</Color>
    <SolidColorBrush x:Key="AccentRed2" Color="#FF6B81"/>
    <LinearGradientBrush x:Key="AccentRedGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#E0244A" Offset="0.0"/>
        <GradientStop Color="#FF6B81" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessGreen" Color="#00B894"/>
    <SolidColorBrush x:Key="SuccessTintBg" Color="#1A00B894"/>
    <SolidColorBrush x:Key="SuccessTintBorder" Color="#5500B894"/>
    <SolidColorBrush x:Key="DangerTintBg" Color="#14E0244A"/>
    <SolidColorBrush x:Key="DangerTintBorder" Color="#55E0244A"/>
    <SolidColorBrush x:Key="SuccessGreen2" Color="#55EFC4"/>
    <LinearGradientBrush x:Key="SuccessGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00B894" Offset="0.0"/>
        <GradientStop Color="#55EFC4" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DangerRed" Color="#E74C3C"/>
    <SolidColorBrush x:Key="DangerBg" Color="#2A1B22"/>
    <SolidColorBrush x:Key="DangerFg" Color="#FFB4AB"/>
    <SolidColorBrush x:Key="BtnDisabledBg" Color="#232A38"/>
    <SolidColorBrush x:Key="BtnDisabledFg" Color="#57606F"/>

    <!-- S4 parity tokens: hover veils + chip fill (theme-aware) -->
    <SolidColorBrush x:Key="HoverVeilStrong" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="HoverVeilSoft" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ChipCheckedBg" Color="#1AE0244A"/>

    <!-- Window Background -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1E222D"/>

    <!-- Instruction banner background -->
    <SolidColorBrush x:Key="InstructionBoxBg" Color="#1C212D"/>

    <!-- Implicit Styles -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ControlInputBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Scrollbar thumb: visible against the panel background -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#6B7688"/>

</ResourceDictionary>
