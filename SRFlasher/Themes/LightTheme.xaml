<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Color Palette -->
    <SolidColorBrush x:Key="ActionBlue" Color="#0078D4"/>
    <SolidColorBrush x:Key="BorderMedium" Color="#BCC2CB"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="LogErrorBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="LogWarningBrush" Color="#A85F00"/>
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#0A7D50"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ControlInputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessMint" Color="#107C10"/>
    <SolidColorBrush x:Key="WarningAmber" Color="#D83B01"/>

    <!-- S1 design tokens: crimson accent + semantic green/red (light theme) -->
    <SolidColorBrush x:Key="AccentRed" Color="#D01935"/>
    <!-- Active-tab underline default (falls back to the theme red;
         each tab may override in its own Resources) -->
    <SolidColorBrush x:Key="TabAccentBrush" Color="#D01935"/>
    <Color x:Key="TabAccentColor">#D01935</Color>
    <!-- Darker than the dark-theme variant: this brush is used as text
         colour, and #E8506B only reached ~3.6:1 on white. -->
    <SolidColorBrush x:Key="AccentRed2" Color="#C0234A"/>
    <!-- Primary button fill: white text sits on this, so the light end must
         stay dark enough for 4.5:1 (the pink stop was ~3.6:1). -->
    <LinearGradientBrush x:Key="AccentRedGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D01935" Offset="0.0"/>
        <GradientStop Color="#C0234A" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessGreen" Color="#0A7D50"/>
    <SolidColorBrush x:Key="SuccessTintBg" Color="#140A7D50"/>
    <SolidColorBrush x:Key="SuccessTintBorder" Color="#330A7D50"/>
    <SolidColorBrush x:Key="DangerTintBg" Color="#14E0244A"/>
    <SolidColorBrush x:Key="DangerTintBorder" Color="#330E9F6E"/>
    <SolidColorBrush x:Key="SuccessGreen2" Color="#3DD68C"/>
    <!-- Success button fill carries white text, so both stops stay dark
         enough to clear 4.5:1 (the old mint gradient was ~1.9:1). -->
    <LinearGradientBrush x:Key="SuccessGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0B7A52" Offset="0.0"/>
        <GradientStop Color="#0C8159" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DangerRed" Color="#D64541"/>
    <SolidColorBrush x:Key="DangerBg" Color="#FDECEA"/>
    <SolidColorBrush x:Key="DangerFg" Color="#C0392B"/>
    <SolidColorBrush x:Key="BtnDisabledBg" Color="#E4E7EC"/>
    <SolidColorBrush x:Key="BtnDisabledFg" Color="#9AA3AF"/>

    <!-- S4 parity tokens: hover veils + chip fill (theme-aware) -->
    <SolidColorBrush x:Key="HoverVeilStrong" Color="#1A000000"/>
    <SolidColorBrush x:Key="HoverVeilSoft" Color="#0A000000"/>
    <SolidColorBrush x:Key="ChipCheckedBg" Color="#0FE0244A"/>

    <!-- Window Background -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF"/>

    <!-- Instruction banner background -->
    <SolidColorBrush x:Key="InstructionBoxBg" Color="#EAF2F6"/>

    <!-- Implicit Styles -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource ControlInputBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Scrollbar thumb: BorderMedium alone was invisible on white -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#8A94A3"/>

</ResourceDictionary>
