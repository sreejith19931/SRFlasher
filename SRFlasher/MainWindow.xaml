<Window x:Class="SRFlasher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:SRFlasher.Utilities"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Height="760" Width="1040"
        MinHeight="620" MinWidth="940"
        UseLayoutRounding="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" PreviewKeyDown="Window_KeyDown"
        Background="{DynamicResource WindowBackground}"
        Icon="Assets/flasher-icon-256.png">

    <Window.Resources>
        <!--
            Design tokens. Values across this file are normalised to:
              type     10 / 11 / 12 / 13 / 16 px  (badge, caption, body, section, page title)
              spacing  4 / 8 / 12 / 16 / 20 / 24 / 32 px  (all Margins and Padding)
              icons    Segoe MDL2 Assets glyphs only — no emoji or mixed symbol fonts
              radius   6 px controls, 10 px panels (pill chips stay fully rounded)
        -->
        <!-- ROM packages (.zip/.tar/.tar.gz/.tgz) can be dragged onto the window
             from Explorer and are validated like the Browse button (see
             Window_Drop). .img files are refused: they are flashed from the
             ADDITIONAL FILES tab. -->
        <!-- Theme colors (ActionBlue, BorderMedium, PanelBackground, TextPrimary,
             TextSecondary, ControlInputBg, SuccessMint, WarningAmber, InstructionBoxBg)
             come from Themes/DarkTheme.xaml or LightTheme.xaml via the app-level
             merged dictionaries, so the theme toggle restyles the whole window. -->

        <!-- Colors log entries by severity -->
        <utils:LogColorConverter x:Key="LogColorConverter"/>
        <utils:FileNameConverter x:Key="FileNameConverter"/>
        <!-- Text scale. Reference these instead of repeating FontSize/Foreground pairs. -->
        <Style x:Key="TextPageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="TextHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="TextCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style x:Key="TextBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <!-- Semantic section accents: 3px left bars colour-code the cards
             (blue = flashing, amber = files, green = device, red = rescue,
             violet = logs). Titles stay neutral — the bar carries the colour. -->
        <SolidColorBrush x:Key="SectionAccentBlue" Color="#4C8DFF"/>
        <SolidColorBrush x:Key="SectionAccentAmber" Color="#E8B341"/>
        <SolidColorBrush x:Key="SectionAccentGreen" Color="#3ECF8E"/>
        <!-- Red accent follows the theme: resolve at use-site instead of a frozen brush -->
        <SolidColorBrush x:Key="SectionAccentViolet" Color="#A78BFA"/>

        <!-- Mini phone outline that frames a brand logo: the detected device's
             logo shows on a tiny phone screen instead of floating bare. -->
        <Style x:Key="PhoneLogoFrame" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="{DynamicResource ControlInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!-- Implicit Styles for standard controls (theme-aware) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Chip-style checkbox: pill with check-circle, red tint when checked -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}"
                                BorderThickness="1" CornerRadius="14" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ChipCheckedBg}"/>
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentRed}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentRed}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentRed2}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ S5 POLISH ============ -->
        <!-- Themed tooltip card (replaces default yellow-ish tooltip) -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed list rows: red-tinted selection instead of default Windows blue -->
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBg" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource ChipCheckedBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource ChipCheckedBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentRed2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed context menu (Log list right-click) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBg" Background="Transparent" CornerRadius="5" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource TextCaption}" Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource ChipCheckedBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentRed2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderMedium}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Opacity="{TemplateBinding Opacity}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Industrial TabItem Style -->
        <Style x:Key="IndustrialTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="8,12" Background="Transparent">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" TextElement.Foreground="{DynamicResource TextSecondary}" RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <!-- The active underline picks up the tab's page
                                     accent: blue for FLASH ROM, amber for
                                     POST-FLASH, green for DEVICE, violet for LOGS;
                                     SETTINGS falls back to the theme's red accent.
                                     Themes define the defaults, each TabItem may
                                     override them in its own Resources. No glow:
                                     the flat underline is the whole statement. -->
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource TabAccentBrush}"/>
                                <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource AccentRed2}"/>
                                <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ S1 BUTTON SYSTEM ============ -->
        <!-- Primary: crimson gradient CTA (destructive/flash actions) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentRedGrad}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#E0244A" BlurRadius="18" ShadowDepth="0" Opacity="0.40"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="PressRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <!-- A5: the press feels like a key, not a click. -->
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9"/>
                            <Border x:Name="HoverVeil" Background="{DynamicResource HoverVeilStrong}" CornerRadius="9" Opacity="0"/>
                            <!-- Focus ring is TextPrimary, not AccentRed: this button's
                                 fill is already red, so a red ring would be invisible. -->
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource TextPrimary}" BorderThickness="2" CornerRadius="9" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="PressRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success: green gradient (completion/success actions) -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource SuccessGrad}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00B894" BlurRadius="18" ShadowDepth="0" Opacity="0.40"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INSTALL ROM: the hero action. Bigger than section CTAs and clearly
             greyed out (no glow) until the ROM is verified and ready. -->
        <Style x:Key="InstallButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="PressRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <Border x:Name="HoverVeil" Background="{DynamicResource HoverVeilStrong}" CornerRadius="10" Opacity="0"/>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource TextPrimary}" BorderThickness="2" CornerRadius="10" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="PressRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnDisabledBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost: neutral outline (secondary actions) -->
        <!-- Mini ghost button for batch row controls (chevrons + remove): 26x24 keeps the
             glyph readable and the hit target usable in the dense queue rows. -->
        <Style x:Key="MiniGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Radio chips (target slot / after flash): the default template drew
             a white OS bullet that ignored both themes. -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse x:Name="Ring" Fill="{DynamicResource ControlInputBg}"
                                         Stroke="{DynamicResource BorderMedium}" StrokeThickness="1.4"/>
                                <Ellipse x:Name="Dot" Width="6" Height="6" Opacity="0"
                                         Fill="{DynamicResource AccentRed}"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented mode switch (SIMPLE | EXPERT): one half highlighted -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{DynamicResource ControlInputBg}" CornerRadius="0"
                                Padding="0,7">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentRed}"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact chip radio (severity filters on the LOGS tab) -->
        <Style x:Key="ChipRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Single source of chip spacing: 8 px after every chip. A local
                 Margin override REPLACES this (it does not add to it) and makes
                 the gaps uneven — do not set inline margins on chips. -->
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{DynamicResource ControlInputBg}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" Padding="10,4">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentRed}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle-button twin of ChipRadio (FOLLOW toggle on the LOGS tab).
             GhostButton targets Button, so a ToggleButton cannot base on it. -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Matches ChipRadio's spacing: one gap rhythm for all chips. -->
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{DynamicResource ControlInputBg}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" Padding="10,4">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource SuccessTintBorder}"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Partition chips (R2 follow-up): uniform look in both states —
             selection is shown by the filled ring + tick, never by recoloring
             the chip or the text. -->
        <Style x:Key="PartitionCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Chip" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}"
                                BorderThickness="1" CornerRadius="14" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Fill="Transparent"/>
                                    <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentRed}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentRed}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Consistent section labels -->
        <!-- ==================== BANNER STYLES ====================
             One conversation-strip look: neutral (info), red (warn),
             green (success). Data-bound banners set colors per state. -->
        <Style x:Key="BannerBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="BannerInfo" TargetType="Border" BasedOn="{StaticResource BannerBase}">
            <Setter Property="Background" Value="{DynamicResource ControlInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
        </Style>
        <Style x:Key="BannerWarn" TargetType="Border" BasedOn="{StaticResource BannerBase}">
            <Setter Property="Background" Value="{DynamicResource InstructionBoxBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
        </Style>
        <Style x:Key="BannerSuccess" TargetType="Border" BasedOn="{StaticResource BannerBase}">
            <Setter Property="Background" Value="{DynamicResource SuccessTintBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessTintBorder}"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
        </Style>

        <!-- Themed ComboBox (sidebar Recent Files): ghost chip + themed dropdown -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bg" Background="{DynamicResource ControlInputBg}"
                                                BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" CornerRadius="8">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="{TemplateBinding SelectionBoxItem}" Margin="12,0,24,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                       ToolTip="{TemplateBinding SelectionBoxItem}"/>
                            <TextBlock Text="No recent files" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       FontSize="11" Foreground="{DynamicResource BtnDisabledFg}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value=""/>
                                                    <Condition Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}"
                                        BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,4,4" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBg" Background="Transparent" CornerRadius="5" Padding="8,4">
                                        <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource ChipCheckedBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentRed2}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded search box with magnifier icon and placeholder -->
        <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}"
                                BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TextCaption}" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Filter logs…" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource BtnDisabledFg}" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                        </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar device-card status LED: green pulse when connected, quiet when not -->
        <Style x:Key="LedDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource SuccessGreen}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00B894" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeviceConnected}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="LedBlink">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="LedBlink"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceConnected}" Value="False">
                    <Setter Property="Fill" Value="{DynamicResource BorderMedium}"/>
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Phone fill height for the FLASHING IN PROGRESS diagram. -->
        <utils:ProgressToPhoneFillConverter x:Key="PhoneFill"/>

        <!-- LOG list with rounded edges: a minimal ListBox template whose
             border carries CornerRadius; background, the violet left accent
             bar and scroll behavior all stay template-bound. -->
        <Style x:Key="RoundedLogList" TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainRootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <!-- Toasts overlay column 1 (Panel.ZIndex) instead of living in
                 their own Auto column — a layout slot would grow to 320 px
                 when a banner slides in and squeeze the center content. -->
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR (collapsible) ==================== -->
        <!-- The whole sidebar locks while flashing: nothing but ABORT may be
             pressed during an active operation. -->
        <Border x:Name="Sidebar" Grid.Column="0" Width="260" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="0,0,1,0"
                IsEnabled="{Binding IsNotFlashing}">
            <DockPanel>
                <Button DockPanel.Dock="Top" x:Name="BtnToggleSidebar" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Width="34" Height="26" FontSize="11" Padding="0"
                        Style="{StaticResource GhostButton}" Margin="8,8,8,0"
                        HorizontalAlignment="Right" Click="BtnToggleSidebar_Click"
                        AutomationProperties.Name="Collapse device panel"
                        ToolTip="Collapse the device panel"/>

                <!-- IDLE FOOTER BAR (D3): thin state line when nothing is
                     running. Lives INSIDE the sidebar, docked as its bottom
                     edge (docked before RECENT so it stays lowest) — as a ZIndex overlay in the root grid it used to
                     cover the recent list's last row. -->
                <Border x:Name="IdleFooter" DockPanel.Dock="Bottom" Visibility="{Binding IdleFooterVisibility}"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderMedium}" BorderThickness="0,1,0,0" Padding="12,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Style="{StaticResource LedDotStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding IdleFooterLeft, Mode=OneWay}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding IdleFooterRight, Mode=OneWay}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding IdleFooterRight, Mode=OneWay}"/>
                    </Grid>
                </Border>
                <!-- Bottom-docked: recent ROMs are never below the fold. The
                     panel carries the sidebar's own background and a separator
                     line so scrolled card content can never visually bleed
                     underneath it. -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderMedium}" BorderThickness="0,1,0,0"
                        Padding="12,8,12,12">
                    <StackPanel>
                        <TextBlock Text="RECENT" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" Margin="4,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="RecentFilesCombo" Height="32"
                                      ItemsSource="{Binding RecentFileDisplays}"
                                      SelectionChanged="RecentFilesCombo_SelectionChanged" ToolTip="Load a recently used ROM"/>
                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                    Width="32" Height="32" Padding="0" Margin="6,0,0,0"
                                    Style="{StaticResource GhostButton}" Click="BtnClearRecent_Click"
                                    ToolTip="Clear the recent list"
                                    AutomationProperties.Name="Clear recent files"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="SidebarFull" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8,12,12">

                        <!-- BRAND HEADER -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <!-- Brand mark: brand/icon/flasher-icon-256.png, exported from Assets\logo-sr.svg -->
                            <Image Width="30" Height="30" Source="Assets/flasher-icon-256.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="SR Flasher logo"/>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextHeading}" Text="SR FLASHER"/>
                                <TextBlock Style="{StaticResource TextCaption}" Text="FLASH CONSOLE · v1.0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- DEVICE CARD -->
                        <Border Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid ClipToBounds="True">
                                <!-- soft accent glow bleeding from the top of the card -->
                                <Border CornerRadius="7,7,0,0" Height="56" VerticalAlignment="Top" IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush GradientOrigin="0.22,0" Center="0.22,0" RadiusX="0.85" RadiusY="1.5">
                                            <GradientStop Color="#22E0244A" Offset="0"/>
                                            <GradientStop Color="#00E0244A" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel>
                                    <!-- Hero: brand-color ring badge + name + connection LED -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Letter ring badge (hidden when a brand logo is available) -->
                                            <Grid Width="52" Height="52" VerticalAlignment="Center"
                                                  Visibility="{Binding DeviceBadgeVisibility}">
                                                <Ellipse Width="52" Height="52" Fill="{Binding DeviceBadgeBrush}" Opacity="0.16"/>
                                                <Border Width="46" Height="46" CornerRadius="23" BorderBrush="{Binding DeviceBadgeBrush}" BorderThickness="2">
                                                    <TextBlock Text="{Binding DeviceBadgeLetter}" FontSize="16" FontWeight="Bold" Foreground="{Binding DeviceBadgeBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <!-- Brand logo (Logos\<Brand>.png next to the exe), shown on a mini phone screen -->
                                            <Border Style="{StaticResource PhoneLogoFrame}" Visibility="{Binding DeviceLogoVisibility}"
                                                    AutomationProperties.Name="Device brand logo">
                                                <Image Source="{Binding DeviceLogoImage}" MaxWidth="24" MaxHeight="18"
                                                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource TextPageTitle}" Text="{Binding DeviceName}" TextWrapping="Wrap" MaxWidth="130"/>
                                                <TextBlock Style="{StaticResource TextBadge}" Text="{Binding DeviceCodename}" TextWrapping="Wrap" MaxWidth="130"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource LedDotStyle}"
                                                 ToolTip="Device connection status"/>
                                    </Grid>

                                    <Border Background="{DynamicResource BorderMedium}" Height="1" Margin="0,8,0,8" Opacity="0.4"/>

                                    <!-- One-line summary: mode (battery lives once, in DEVICE DETAILS) -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SidebarModeText" Text="{Binding DeviceModeDisplay}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" MaxWidth="104" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Bootloader chip stays visible: it is the safety-critical value -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="BOOTLOADER" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Grid>
                                            <Border CornerRadius="10" Background="{Binding DeviceBootloaderBrush}" Opacity="0.16" Padding="8,4"/>
                                            <TextBlock Text="{Binding DeviceBootloaderState}" Foreground="{Binding DeviceBootloaderBrush}" FontSize="11" FontWeight="Bold" Padding="8,4" VerticalAlignment="Center"/>
                                    </Grid>
                                    </StackPanel>

                                    <!-- Everything else folds into DETAILS -->
                                    <Expander Margin="0,8,0,0">
                                        <Expander.Header>
                                            <TextBlock Text="DEVICE DETAILS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                        </Expander.Header>
                                    <StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="ANDROID" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DeviceAndroidDisplay}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource TextBadge}" Text="{Binding DeviceSecurityPatch}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="BATTERY" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ProgressBar Width="44" Height="6" Minimum="0" Maximum="100" Value="{Binding DeviceBatteryLevel, Mode=OneWay}"
                                                         Background="{DynamicResource BorderMedium}" BorderThickness="0" Foreground="{Binding DeviceBatteryBarBrush}"
                                                         Visibility="{Binding DeviceBatteryBarVisibility}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DeviceBatteryDisplay}" Margin="8,0,0,0" Foreground="{Binding DeviceBatteryBrush}" FontSize="11" FontWeight="Bold"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="72"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="ACTIVE SLOT" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Grid>
                                            <Border CornerRadius="10" Background="{DynamicResource BorderMedium}" Opacity="0.55" Padding="8,4"/>
                                            <TextBlock Text="{Binding DeviceSlotDisplay}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" Padding="8,4" VerticalAlignment="Center"
                                                       MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="SERIAL" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding DeviceSerialDisplay}" VerticalAlignment="Center"
                                                       MaxWidth="86" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceSerialDisplay}"/>
                                        <Button x:Name="BtnCopySerial" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondary}" Click="BtnCopySerial_Click"
                                                ToolTip="Copy the serial number (for support posts)"
                                                AutomationProperties.Name="Copy device serial"/>
                                    </StackPanel>

                                    <!-- Anti-rollback (Xiaomi/HyperOS; visible only when the device reports it) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding DeviceAntiVisibility}">
                                        <TextBlock Text="ANTI-ROLLBACK" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Grid>
                                            <Border CornerRadius="10" Background="{DynamicResource DangerTintBg}" Padding="8,4"/>
                                            <TextBlock Text="{Binding DeviceAntiDisplay}" Foreground="{Binding DeviceAntiBrush}" FontSize="11" FontWeight="Bold" Padding="8,4" VerticalAlignment="Center"
                                                       MaxWidth="110" TextTrimming="CharacterEllipsis"
                                                       ToolTip="Flashing firmware older than this anti version may permanently brick the device"/>
                                    </Grid>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DeviceLastSeen}" Foreground="{DynamicResource WarningAmber}" FontSize="10" Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>

                                    </StackPanel>
                                    </Expander>

                                    <!-- Empty-state hint: shown only when no device is connected -->
                                    <Border Margin="0,8,0,0" CornerRadius="6" Padding="8,8"
                                            Background="{DynamicResource BorderMedium}" Opacity="0.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceConnected}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="NO DEVICE DETECTED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Style="{StaticResource TextCaption}" Text="Connect your phone and enable USB debugging (ADB) or reboot to bootloader (fastboot) to see live details here." TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Theme + log actions are on the SETTINGS and LOGS pages. -->
                                </StackPanel>
                                </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- Collapsed icon rail -->
        <Border x:Name="SidebarRail" Grid.Column="0" Width="52" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="0,0,1,0" Visibility="Collapsed"
                IsEnabled="{Binding IsNotFlashing}">
            <StackPanel>
                <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Width="30" Height="26" FontSize="11" Padding="0" Style="{StaticResource GhostButton}" Margin="0,8,0,12" HorizontalAlignment="Center"
                        Click="BtnToggleSidebar_Click" AutomationProperties.Name="Expand device panel" ToolTip="Expand the device panel"/>

                <!-- Device badge (ring style, matches the expanded card);
                     dims to 40% when no device is connected. -->
                <Grid Width="36" Height="36" HorizontalAlignment="Center" Margin="0,0,0,8"
                      ToolTip="{Binding DeviceName}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeviceConnected}" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Ellipse Width="36" Height="36" Fill="{Binding DeviceBadgeBrush}" Opacity="0.16"/>
                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="{Binding DeviceBadgeBrush}" BorderThickness="1.5">
                        <TextBlock Text="{Binding DeviceBadgeLetter}" FontSize="16" FontWeight="Bold" Foreground="{Binding DeviceBadgeBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding DeviceBatteryDisplay}" HorizontalAlignment="Center" Foreground="{Binding DeviceBatteryBrush}" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap" TextAlignment="Center"/>

                <!-- Connection LED mirrored from the expanded card -->
                <Ellipse Width="8" Height="8" HorizontalAlignment="Center" Margin="0,0,0,12" Style="{StaticResource LedDotStyle}"
                         ToolTip="Device connection status"/>

                <Border Background="{DynamicResource BorderMedium}" Height="1" Margin="8,0,8,12" Opacity="0.5"/>

                <!-- Settings lives on the gear + the SETTINGS tab header; the
                     theme lives on the settings page; log actions live on the
                     LOGS tab header. Nothing is duplicated here anymore. -->
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" FontSize="12" Padding="0" Style="{StaticResource GhostButton}" Margin="0,0,0,8"
                        Click="BtnOpenSettings_Click" AutomationProperties.Name="Settings"
                        ToolTip="Settings — theme, flashing options, backups, tools"/>
                <!-- Theme, log actions and diagnostics each live on exactly
                     one page (SETTINGS / LOGS) — the rail stays minimal. -->
            </StackPanel>
        </Border>

        <!-- ==================== CONTENT ==================== -->
        <Grid x:Name="MainContent" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- EASY FLOW · step trail: six stages the session walks through.
                 Completed steps turn green, the current one carries the red
                 accent; covered by the flashing overlay when an operation runs. -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderMedium}" BorderThickness="0,0,0,1"
                    Padding="16,9,16,8">
                <StackPanel>
                    <ItemsControl x:Name="StepTrailHost" ItemsSource="{Binding StepTrailSteps}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- connector drawn before every step except the first -->
                                    <Rectangle Width="36" Height="1.5" Fill="{DynamicResource BorderMedium}"
                                               Margin="10,0,10,0" VerticalAlignment="Center">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <!-- stage dot: green filled when done, red ring when current -->
                                    <Grid Width="17" Height="17" VerticalAlignment="Center">
                                        <Ellipse StrokeThickness="2">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Stroke" Value="{DynamicResource BorderMedium}"/>
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessGreen}"/>
                                                            <Setter Property="Stroke" Value="{DynamicResource SuccessGreen}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Current">
                                                            <Setter Property="Stroke" Value="{DynamicResource AccentRed}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Done">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Current">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StepTrailHint, Mode=OneWay}" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Main Tab Container -->
            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderMedium}" Margin="0,0,0,0"
                        SelectionChanged="MainTabs_SelectionChanged"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                <!-- TAB 1: ROM SELECTION -->
                <TabItem x:Name="TabRom" Style="{StaticResource IndustrialTabItem}">
                <TabItem.Resources>
                    <SolidColorBrush x:Key="TabAccentBrush" Color="#4C8DFF"/>
                    <Color x:Key="TabAccentColor">#4C8DFF</Color>
                </TabItem.Resources>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="ROM" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,20">
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{StaticResource SectionAccentBlue}" BorderThickness="3,0,0,0" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Page header; ADVANCED lives here (ROM tab only) -->
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource TextPageTitle}" Text="FLASH ROM"/>
                                        <TextBlock Text="Select a package, choose what to write, then flash."
                                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- ADVANCED toggle: Simple mode is the default; this chip
                                         unlocks the expert controls on this tab -->
                                    <ToggleButton Grid.Column="1" VerticalAlignment="Top"
                                                  Content="ADVANCED" Height="24" FontSize="9" Padding="10,0"
                                                  IsChecked="{Binding IsExpertMode, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsNotFlashing}"
                                                  Style="{StaticResource ChipToggle}"
                                                  ToolTip="Show advanced controls: partitions, vbmeta, recovery tools"
                                                  AutomationProperties.Name="Toggle advanced mode"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- THE PLAN card — the contract for the button (both modes) -->
                                <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource BannerInfo}"
                                        Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource AccentRed}" CornerRadius="2" VerticalAlignment="Stretch"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="THE PLAN" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding RomPlanSummary}"
                                                       Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border CornerRadius="10" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                        Padding="8,3" Margin="0,0,6,0" Visibility="{Binding RomPlanPartitionsVisibility}">
                                                    <TextBlock Text="{Binding RomPlanPartitionsChip}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                </Border>
                                                <Border CornerRadius="10" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                        Padding="8,3" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding RomPlanWipeChip}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                </Border>
                                                <Border CornerRadius="10" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                        Padding="8,3">
                                                    <TextBlock Text="{Binding RomPlanAfterChip}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        </Grid>
                                    </Border>


                                    <!-- Row 1: ROM drop zone - empty state invites a drop;
                                         loaded state becomes a file card. -->
                                    <Border x:Name="RomDropZone" Grid.Row="1" Grid.ColumnSpan="2"
                                            AllowDrop="True"
                                            DragOver="RomDropZone_DragOver"
                                            DragLeave="RomDropZone_ResetHighlight"
                                            Drop="RomDropZone_ResetHighlight"
                                            Background="Transparent" BorderThickness="0"
                                            MouseLeftButtonUp="RomDropZone_Click"
                                            Cursor="Hand"
                                            ToolTip="Click to browse for a ROM package, or drag &amp; drop one here"
                                            CornerRadius="10" Padding="0" MinHeight="190">
                                        <Grid>
                                            <!-- Dotted drop-area outline -->
                                            <Rectangle x:Name="RomDropZoneOutline" RadiusX="10" RadiusY="10"
                                                       Stroke="{DynamicResource BorderMedium}" StrokeThickness="1.5"
                                                       StrokeDashArray="4 3" StrokeDashCap="Round"
                                                       Fill="{DynamicResource ControlInputBg}"/>
                                        <!-- EMPTY STATE: invite drag & drop -->
                                        <Grid Margin="30,26" Visibility="{Binding RomFileEmptyVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                                                    BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentRed}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="DRAG &amp; DROP A ROM PACKAGE"
                                                           Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Style="{StaticResource TextCaption}" Text="...or use Browse. Accepts .zip, .tar, .tar.gz and .tgz." Margin="0,4,0,0"/>
                                                <!-- AllowDrop=False so a file dropped on the path still
                                                     reaches the zone instead of the text box's own drag-drop. -->
                                                <TextBox x:Name="PathText" IsReadOnly="True" AllowDrop="False"
                                                         Text="No file selected." Margin="0,8,0,0" Padding="0"
                                                         Background="Transparent" BorderThickness="0"
                                                         FontFamily="Consolas, Cascadia Code" FontSize="11"
                                                         VerticalAlignment="Center"
                                                         MouseDoubleClick="PathText_MouseDoubleClick"
                                                         ToolTip="ROM path - double-click to copy to clipboard"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- LOADED STATE: file card with check chips -->
                                        <Grid Margin="30,26" Visibility="{Binding RomFileLoadedVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                    BorderBrush="{DynamicResource SuccessTintBorder}" BorderThickness="1"
                                                    Background="{DynamicResource SuccessTintBg}"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                           Foreground="{DynamicResource SuccessGreen}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RomFileName}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SelectedFilePath}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <!-- Size -->
                                                    <Border CornerRadius="10" Padding="8,3" Margin="0,0,6,0"
                                                            Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                            Visibility="{Binding RomFileSizeVisibility}">
                                                        <TextBlock Text="{Binding RomFileSizeDisplay}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                                    </Border>
                                                    <!-- Package type -->
                                                    <Border CornerRadius="10" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                            Padding="8,3" Margin="0,0,6,0" Visibility="{Binding RomKindVisibility}">
                                                        <TextBlock Text="{Binding RomKindDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                    </Border>
                                                    <!-- Device compatibility -->
                                                    <Border CornerRadius="10" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                            Padding="8,3" Margin="0,0,6,0" Visibility="{Binding RomCompatibilityVisibility}">
                                                        <TextBlock Text="{Binding RomCompatibilityText}" FontSize="10" Foreground="{Binding RomCompatibilityBrush}"/>
                                                    </Border>
                                                    <!-- Checksum integrity -->
                                                    <Border CornerRadius="10" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                            Padding="8,3" Visibility="{Binding RomIntegrityVisibility}">
                                                        <TextBlock Text="{Binding RomIntegrityText}" FontSize="10" Foreground="{Binding RomIntegrityBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    </Border>

                                    <!-- Row 1: what fastboot cannot do with this package -->
                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0"
                                            Style="{StaticResource BannerWarn}"
                                            Visibility="{Binding RomRouteBannerVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RomRouteHeadline}" Foreground="{DynamicResource AccentRed2}"
                                                       FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding RomRouteText}" Foreground="{DynamicResource TextSecondary}"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Button x:Name="BtnInstallRomRecovery" Content="INSTALL FROM RECOVERY (SIDELOAD)"
                                                    Style="{StaticResource PrimaryButton}" Height="34" FontSize="11"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0" Padding="16,0"
                                                    Click="BtnInstallRomRecovery_Click"
                                                    Visibility="{Binding RomSideloadVisibility}"
                                                    IsEnabled="{Binding RomSideloadEnabled}" ToolTip="{Binding RomSideloadReason}"
                                                    AutomationProperties.Name="Install the selected ROM from recovery"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Row 2: plan (simple) or the full control set (expert) -->
                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,16,0,0">

                                        <!-- Expert mode: partitions, slot and vbmeta -->
                                        <StackPanel Orientation="Vertical" Visibility="{Binding AdvancedVisibility}">
                                        <Grid>
                                            <TextBlock Text="PARTITIONS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PartitionSelectionCount}" Style="{StaticResource TextBadge}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Content="ALL" Style="{StaticResource MiniGhostButton}" Width="42" Height="22" FontSize="10" Margin="0,0,8,0"
                                                        Click="BtnSelectAllPartitions_Click" ToolTip="Select every partition"
                                                        AutomationProperties.Name="Select all partitions"/>
                                                <Button Content="NONE" Style="{StaticResource MiniGhostButton}" Width="50" Height="22" FontSize="10"
                                                        Click="BtnClearPartitions_Click" ToolTip="Deselect every partition"
                                                        AutomationProperties.Name="Deselect all partitions"/>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl x:Name="PartitionContainer" ItemsSource="{Binding PartitionOptions}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}" Margin="0,0,8,8"
                                                                  Style="{StaticResource PartitionCheck}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        <!-- Flash options (vbmeta verity; the wipe choice
                                             lives in the DATA chips above, both modes) -->
                                        <TextBlock Text="FLASH OPTIONS" Style="{StaticResource SectionLabel}" Margin="0,16,0,0"/>
                                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <CheckBox x:Name="ChkVbmetaVerity" Content="vbmeta: disable verity &amp; verification" Margin="0,0,8,8"
                                                      IsChecked="{Binding ChkVbmetaVerityOff, Mode=TwoWay}"
                                                      ToolTip="Flash vbmeta with --disable-verity --disable-verification (required by many AOSP ↔ HyperOS/MIUI migrations to prevent bootloops)"/>
                                        </WrapPanel>

                                        </StackPanel>

                                    <!-- Row 2b: clean or dirty flash — the same chips in
                                         both Simple and Advanced views (one backing flag) -->
                                    <StackPanel Margin="0,18,0,0">
                                        <TextBlock Text="DATA" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="How the install handles your apps, photos and settings."
                                                   Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <RadioButton Content="DIRTY — keep apps &amp; data" GroupName="WipeMode" Style="{StaticResource ChipRadio}"
                                                         IsChecked="{Binding IsDirtyFlash, Mode=TwoWay}"
                                                         ToolTip="Dirty flash: user data (apps, photos, settings) is preserved. Right for updates within the same ROM."/>
                                            <RadioButton Content="CLEAN — erase everything" GroupName="WipeMode" Style="{StaticResource ChipRadio}"
                                                         IsChecked="{Binding IsCleanFlash, Mode=TwoWay}"
                                                         ToolTip="Clean flash: runs 'fastboot -w' before flashing (userdata erased). Required when switching ROM families (AOSP ↔ HyperOS/MIUI)."/>
                                        </StackPanel>
                                    </StackPanel>
                                    </StackPanel>

                                    <!-- Row 3: Reboot and Flash buttons -->
                                    <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,24,0,0">
                                        <!-- One-click install: a single primary action. Manual
                                             bootloader reboots live on ADDITIONAL FILES (BOOTLOADER
                                             chip → FINISH &amp; REBOOT). While disabled it is
                                             greyed out and states WHY on the button itself. -->
                                        <Button x:Name="BtnFlash" Style="{StaticResource InstallButton}" IsEnabled="{Binding FlashEnabled}" Click="BtnFlash_Click">
                                            <StackPanel>
                                                <TextBlock HorizontalAlignment="Center">
                                                    <Run Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14"/><Run Text="   "/><Run Text="{Binding FlashActionLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FlashReason, Mode=OneWay}" FontSize="9.5" TextAlignment="Center"
                                                           TextWrapping="Wrap" MaxWidth="360" Margin="0,3,0,0" Foreground="{DynamicResource BtnDisabledFg}"
                                                           Visibility="Collapsed">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Row 5: AFTER CARE (Simple mode) — honest outcome
                                         panel with the exact journal and next steps.
                                         (Declared before the Row 4 banner in markup; the
                                         Grid.Row attribute, not the order, positions it.) -->
                                    <Border Grid.Row="6" Grid.ColumnSpan="2" Margin="0,16,0,0"
                                            Style="{StaticResource BannerSuccess}"
                                            Visibility="{Binding AfterCareVisibility}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding AfterCareHeadline}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AfterCareBody}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                       TextWrapping="Wrap" Margin="0,8,0,10" FontFamily="Consolas, Segoe UI"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnCopyReport" Content="COPY REPORT" Style="{StaticResource GhostButton}"
                                                        HorizontalAlignment="Left" Height="32" FontSize="11" Padding="14,0"
                                                        Click="BtnCopyReport_Click"
                                                        ToolTip="Copy the flash journal (what was written, when) to the clipboard"
                                                        AutomationProperties.Name="Copy the flash report to the clipboard"/>
                                                <Button x:Name="BtnAfterCarePostFlash" Content="OPEN POST-FLASH" Style="{StaticResource GhostButton}"
                                                        HorizontalAlignment="Left" Height="32" FontSize="11" Padding="14,0" Margin="8,0,0,0"
                                                        Click="BtnAfterCarePostFlash_Click"
                                                        ToolTip="Switch to the POST-FLASH tab for zips, recovery and extra images"
                                                        AutomationProperties.Name="Open the POST-FLASH tab"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                <!-- Row 4: live step banner — state-colored
                                     (neutral / red on failure / green on success),
                                     hidden while the after-care panel is up. -->
                                    <Border Grid.Row="5" Grid.ColumnSpan="2" x:Name="RomInstructionBox"
                                            Margin="0,16,0,0"
                                            Background="{Binding RomStepBg}"
                                            BorderBrush="{Binding RomStepBorderBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource BannerBase}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowAfterCare}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding RomStepBorderBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="RomInstructionText"
                                                       Text="{Binding RomStepText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <!-- 4.4: loose boot images inside the package (Magisk patching) -->
                                    <StackPanel Orientation="Horizontal" Margin="12,8,0,0"
                                                Visibility="{Binding RomLooseBootVisibility}">
                                        <Button x:Name="BtnExtractBootImage" Style="{StaticResource GhostButton}" Height="32" MinWidth="170"
                                                FontSize="11" Content="EXTRACT BOOT IMAGE"
                                                Click="BtnExtractBootImage_Click"
                                                IsEnabled="{Binding IsNotFlashing}"
                                                ToolTip="Extracts boot.img (plus init_boot / vendor_boot if present) to Documents\SRFlasher\Extracted — ready to patch in the Magisk app"/>
                                        <TextBlock Text="{Binding RomLooseImagesText}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                   Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="330"/>
                                    </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 2: POST-FLASH -->
                <TabItem x:Name="TabAdditional" Style="{StaticResource IndustrialTabItem}">
                <TabItem.Resources>
                    <SolidColorBrush x:Key="TabAccentBrush" Color="#E8B341"/>
                    <Color x:Key="TabAccentColor">#E8B341</Color>
                </TabItem.Resources>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="ADDITIONAL FILES" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <!-- ScrollViewer: at short window heights the cards clip —
                         everything below the fold must stay reachable. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="24,20,24,20" x:Name="PostFlashLayoutGrid" SizeChanged="PostFlashLayoutGrid_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Page header + tab-wide live status -->
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource TextPageTitle}" Text="ADDITIONAL FILES"/>
                            <TextBlock Text="Extras, recovery and migration work once the ROM is installed."
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,8"/>
                            <!-- D1: the device state line explains WHY actions are gated -->
                            <Border Style="{StaticResource BannerInfo}" Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Style="{StaticResource LedDotStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                        <Run Text="DEVICE IS IN "/><Run Text="{Binding DeviceModeDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/><Run Text=" — actions enable when the device reaches the mode they need."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border x:Name="AddInstructionBox" Margin="0,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BannerWarn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdditionalStepText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AdditionalStepText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="NEXT STEP REQUIRED:" Foreground="{DynamicResource AccentRed2}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="AddInstructionText" Text="{Binding AdditionalStepText}"
                                               Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- FILE CARD: one drop/browse slot for .zip and .img;
                             the file type decides the next step -->
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{StaticResource SectionAccentAmber}"
                                BorderThickness="3,0,0,0" CornerRadius="8" Padding="20" Margin="0,0,16,0">
                            <StackPanel>
                                <TextBlock Text="ADD A FILE" Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                                <Border x:Name="AdditionalDropZone" AllowDrop="True"
                                        DragOver="AdditionalDropZone_DragOver"
                                        DragLeave="AdditionalDropZone_ResetHighlight"
                                        Drop="AdditionalDropZone_Drop"
                                        Background="Transparent" BorderThickness="0"
                                        MouseLeftButtonUp="AdditionalDropZone_Click"
                                        Cursor="Hand"
                                        ToolTip="Click to browse for a .zip or .img file, or drag &amp; drop one here"
                                        CornerRadius="10" Padding="0" MinHeight="190">
                                    <Grid>
                                        <!-- Dotted drop-area outline -->
                                        <Rectangle x:Name="AdditionalDropZoneOutline" RadiusX="10" RadiusY="10"
                                                   Stroke="{DynamicResource BorderMedium}" StrokeThickness="1.5"
                                                   StrokeDashArray="4 3" StrokeDashCap="Round"
                                                   Fill="{DynamicResource ControlInputBg}"/>
                                    <!-- EMPTY STATE -->
                                    <Grid Margin="30,26" Visibility="{Binding RecoveryFileEmptyVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentRed}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="DRAG &amp; DROP A .ZIP OR .IMG"
                                                       Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Style="{StaticResource TextCaption}"
                                                       Text=".zip installs through recovery sideload — .img flashes in fastboot. The mode rules apply."
                                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- LOADED STATE -->
                                    <Grid Margin="30,26" Visibility="{Binding RecoveryFileLoadedVisibility}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                BorderBrush="{DynamicResource SuccessTintBorder}" BorderThickness="1"
                                                Background="{DynamicResource SuccessTintBg}"
                                                VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource SuccessGreen}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding RecoveryFileName, Mode=OneWay}"
                                                           Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center"/>
                                                <Border CornerRadius="8" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                                        Visibility="{Binding RecoveryFileTypeVisibility}">
                                                    <TextBlock Text="{Binding RecoveryFileTypeDisplay, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    </Grid>
                                </Border>

                                <!-- 3.4: recents for this slot -->
                                <ComboBox x:Name="AdditionalRecentCombo" Margin="0,10,0,0" Height="32"
                                          ItemsSource="{Binding RecentAdditional}"
                                          SelectionChanged="AdditionalRecentCombo_SelectionChanged"
                                          Visibility="{Binding RecentAdditionalVisibility}"
                                          ToolTip="Recently added files — click to re-select">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Contextual next step for a .zip -->
                                <StackPanel Visibility="{Binding AdditionalZipPlainVisibility}" Margin="0,12,0,0">
                                    <Button x:Name="BtnApplyAdditionalZip" Content="APPLY UPDATE.ZIP (SIDELOAD)" Style="{StaticResource PrimaryButton}"
                                            Height="36" Click="BtnApplyAdditionalZip_Click"
                                            IsEnabled="{Binding AdditionalZipActionEnabled}" ToolTip="{Binding AdditionalZipActionReason}"/>
                                    <TextBlock Text="{Binding AdditionalZipActionReason, Mode=OneWay}" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Recovery-INSTALLER zip (OrangeFox / TWRP): sideload it
                                     to replace the current recovery, then reboot back
                                     into the freshly installed custom recovery -->
                                <StackPanel Visibility="{Binding AdditionalZipInstallerVisibility}" Margin="0,12,0,0">
                                    <Button x:Name="BtnApplyRecoveryInstallerZip" Style="{StaticResource PrimaryButton}" Height="36"
                                            Click="BtnApplyAdditionalZip_Click"
                                            IsEnabled="{Binding AdditionalZipActionEnabled}" ToolTip="{Binding AdditionalZipActionReason}">
                                        <TextBlock><Run Text="INSTALL RECOVERY ZIP"/><Run Text="  (SIDELOAD)"/></TextBlock>
                                    </Button>
                                    <Button x:Name="BtnFlashRecoveryBothSlots" Style="{StaticResource GhostButton}" Height="34" Margin="0,8,0,0"
                                            Click="BtnFlashRecoveryBothSlots_Click"
                                            IsEnabled="{Binding RecoveryBothSlotsEnabled}" ToolTip="{Binding RecoveryBothSlotsReason}"
                                            Visibility="{Binding RecoveryBothSlotsVisibility}"
                                            Content="REPAIR RECOVERY — FLASH IMG TO BOTH SLOTS"/>
                                    <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Text="The installer zip replaces the device's current recovery with the new one — on A/B devices with a recovery partition it writes BOTH slots itself. After it applies, use REBOOT TO RECOVERY."/>
                                    <TextBlock Text="{Binding AdditionalZipActionReason, Mode=OneWay}" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Contextual next step for a custom recovery image -->
                                <StackPanel Visibility="{Binding AdditionalRecoveryVisibility}" Margin="0,12,0,0">
                                    <Button x:Name="BtnBootRecoveryImage" Style="{StaticResource PrimaryButton}" Height="36"
                                            Click="BtnBootRecoveryImage_Click"
                                            IsEnabled="{Binding BootRecoveryImageEnabled}" ToolTip="{Binding BootRecoveryImageReason}">
                                        <TextBlock><Run Text="BOOT RECOVERY"/><Run Text="  (TEMPORARY — WRITES NOTHING)"/></TextBlock>
                                    </Button>
                                    <TextBlock Text="{Binding BootRecoveryImageReason, Mode=OneWay}" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <Button x:Name="BtnFlashRecoveryImage" Style="{StaticResource GhostButton}" Height="34" Margin="0,10,0,0"
                                            Click="BtnFlashRecoveryImage_Click"
                                            IsEnabled="{Binding FlashRecoveryImageEnabled}" ToolTip="{Binding FlashRecoveryImageReason}"
                                            Content="FLASH RECOVERY (PERSISTENT)"/>
                                    <TextBlock Text="{Binding FlashRecoveryImageReason, Mode=OneWay}" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Contextual next step for a plain .img -->
                                <StackPanel Visibility="{Binding AdditionalPlainImageVisibility}" Margin="0,12,0,0">
                                    <Button x:Name="BtnFlashAdditionalImage" Style="{StaticResource PrimaryButton}" Height="36"
                                            Click="BtnFlashAdditionalImage_Click"
                                            IsEnabled="{Binding AdditionalImageActionEnabled}" ToolTip="{Binding AdditionalImageActionReason}">
                                        <TextBlock><Run Text="FLASH IMAGE"/><Run Text="  →  "/><Run Text="{Binding AdditionalImagePartition, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                    </Button>
                                    <CheckBox x:Name="ChkBootBothSlots" Content="Write to BOTH slots (root survives the next OTA slot flip)"
                                              FontSize="11" Margin="0,6,0,0"
                                              IsChecked="{Binding AdditionalImageBothSlots, Mode=TwoWay}"
                                              Visibility="{Binding AdditionalImageBothSlotsVisible}"/>
                                    <TextBlock Text="{Binding AdditionalImageActionReason, Mode=OneWay}" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Stock recovery backup (safety net) -->
                                <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,8"
                                        Background="{DynamicResource SuccessTintBg}"
                                        BorderBrush="{DynamicResource SuccessTintBorder}" BorderThickness="1"
                                        Visibility="{Binding RecoveryBackupVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RecoveryBackupText}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                        <Button x:Name="BtnRestoreStockRecovery" Style="{StaticResource GhostButton}"
                                                Height="30" FontSize="11" Padding="14,0" Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Content="RESTORE STOCK RECOVERY"
                                                Click="BtnRestoreStockRecovery_Click"
                                                IsEnabled="{Binding RecoveryStockRestoreEnabled}"
                                                ToolTip="{Binding RecoveryStockRestoreReason}"/>
                                        <!-- 3.6: full inventory of this device's PC backups
                                             (A4: fades/slides in when populated) -->
                                        <ItemsControl ItemsSource="{Binding BackupInventory}" Margin="0,8,0,0"
                                                      utils:Motion.FadeInOnShow="True">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="10" FontFamily="Consolas, Cascadia Code"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               ToolTip="{Binding FullPath}">
                                                        <Run Text="{Binding FileName, Mode=OneWay}"/>
                                                        <Run Text="  (" Foreground="{DynamicResource TextSecondary}"/>
                                                        <Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                                        <Run Text=", "/>
                                                        <Run Text="{Binding Recorded, Mode=OneWay}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="BtnOpenBackupsFolder" Style="{StaticResource GhostButton}"
                                                    Height="26" FontSize="10" Padding="10,0"
                                                    Content="OPEN FOLDER" Click="BtnOpenBackupsFolder_Click"/>
                                            <Button x:Name="BtnDeleteOldBackups" Style="{StaticResource GhostButton}"
                                                    Height="26" FontSize="10" Padding="10,0" Margin="8,0,0,0"
                                                    Content="DELETE OLD SETS" Click="BtnDeleteOldBackups_Click"
                                                    IsEnabled="{Binding RecoveryBackupExists}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- P5: TWRP boot backup / restore (CLI) -->
                                <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,8"
                                        Background="{DynamicResource SuccessTintBg}"
                                        BorderBrush="{DynamicResource SuccessTintBorder}" BorderThickness="1"
                                        Visibility="{Binding RecoveryTwrpBackupVisibility}">
                                    <StackPanel>
                                        <TextBlock Text="SAFETY BACKUP INSIDE THE RECOVERY" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="Saves the boot image (kernel + recovery ramdisk) to /sdcard via the twrp CLI — restore it if a flash breaks the boot chain."
                                                   FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="BtnTwrpBackupBoot" Style="{StaticResource GhostButton}"
                                                    Height="30" FontSize="11" Padding="14,0"
                                                    Content="BACK UP BOOT (TWRP)"
                                                    Click="BtnTwrpBackupBoot_Click"
                                                    IsEnabled="{Binding RecoveryTwrpBackupEnabled}"
                                                    ToolTip="{Binding RecoveryTwrpBackupReason}"/>
                                            <Button x:Name="BtnTwrpRestoreBoot" Style="{StaticResource GhostButton}"
                                                    Height="30" FontSize="11" Padding="14,0" Margin="8,0,0,0"
                                                    Content="RESTORE BOOT (TWRP)"
                                                    Click="BtnTwrpRestoreBoot_Click"
                                                    IsEnabled="{Binding RecoveryTwrpRestoreEnabled}"
                                                    ToolTip="{Binding RecoveryTwrpRestoreReason}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- P3: direct install routes (twrp CLI detected) -->
                                <StackPanel Visibility="{Binding RecoveryZipCliVisibility}" Margin="0,10,0,0">
                                    <Button x:Name="BtnInstallZipCli" Style="{StaticResource GhostButton}" Height="34"
                                            Content="INSTALL ZIP VIA TWRP (CLI)"
                                            Click="BtnInstallZipCli_Click"
                                            IsEnabled="{Binding RecoveryCliInstallEnabled}" ToolTip="{Binding RecoveryCliInstallReason}"/>
                                    <TextBlock Text="{Binding RecoveryCliInstallReason, Mode=OneWay}" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding RecoveryImageCliVisibility}" Margin="0,10,0,0">
                                    <Button x:Name="BtnFlashImageCli" Style="{StaticResource GhostButton}" Height="34"
                                            Click="BtnFlashImageCli_Click"
                                            IsEnabled="{Binding RecoveryCliFlashImageEnabled}" ToolTip="{Binding RecoveryCliFlashImageReason}">
                                        <TextBlock><Run Text="FLASH IMAGE VIA TWRP"/><Run Text="  →  "/><Run Text="{Binding AdditionalImagePartition, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                    </Button>
                                    <TextBlock Text="{Binding RecoveryCliFlashImageReason, Mode=OneWay}" Style="{StaticResource TextCaption}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- P2: what recovery is running and what it can do -->
                                <Border Margin="0,12,0,0" CornerRadius="6" Padding="10,8"
                                        Background="{DynamicResource ControlInputBg}"
                                        BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1"
                                        Visibility="{Binding RecoveryProbeVisibility}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RecoveryProbeSummary}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextWrapping="Wrap" ToolTip="Detected by the app while the device is in recovery"/>
                                        <Button x:Name="BtnProbeRecheck" Style="{StaticResource GhostButton}" Height="24"
                                                FontSize="10" Padding="10,0" Margin="8,0,0,0" VerticalAlignment="Top"
                                                Content="RE-CHECK" Click="BtnProbeRecheck_Click"
                                                IsEnabled="{Binding RecoveryProbeRecheckEnabled}"
                                                ToolTip="{Binding RecoveryProbeRecheckReason}"/>
                                    </StackPanel>
                                </Border>

                                <!-- What the last flash wrote (transparency, collapsed) -->
                                <Expander Margin="0,10,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="WHAT THE LAST FLASH WROTE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    </Expander.Header>
                                    <Border Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AdditionalMappingHeadline}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding AdditionalLastMapping}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10" FontFamily="Consolas, Cascadia Code"
                                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,2"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- DEVICE CARD: the three reboots, gated by the current mode -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{StaticResource SectionAccentAmber}"
                                BorderThickness="3,0,0,0" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="DEVICE" Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DeviceModeDisplay, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                                <Button x:Name="BtnRebootBootloaderAdditional" Style="{StaticResource GhostButton}" Height="34" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8" Click="BtnRebootBootloaderAdditional_Click"
                                        IsEnabled="{Binding RebootBootloaderEnabled}" ToolTip="{Binding RebootBootloaderReason}">
                                    <TextBlock><Run Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/><Run Text="   REBOOT TO BOOTLOADER"/></TextBlock>
                                </Button>
                                <Button x:Name="BtnRebootRecovery" Style="{StaticResource GhostButton}" Height="34" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,8" Click="BtnRebootRecovery_Click"
                                        IsEnabled="{Binding RebootRecoveryEnabled}" ToolTip="{Binding RebootRecoveryReason}">
                                    <TextBlock><Run Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/><Run Text="   REBOOT TO RECOVERY"/></TextBlock>
                                </Button>
                                <Button x:Name="BtnRebootSystemAdditional" Style="{StaticResource GhostButton}" Height="34" HorizontalContentAlignment="Left"
                                        Margin="0,0,0,10" Click="BtnRebootSystemAdditional_Click"
                                        IsEnabled="{Binding RebootSystemEnabled}" ToolTip="{Binding RebootSystemReason}">
                                    <TextBlock><Run Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13"/><Run Text="   REBOOT TO SYSTEM"/></TextBlock>
                                </Button>
                                <TextBlock Style="{StaticResource TextCaption}"
                                           Text="In recovery: add .zip packages. In bootloader: add .img images. The action button above adapts to the file you add."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- FINISH STRIP: wipes and the way out -->
                        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource PanelBackground}" BorderBrush="{StaticResource SectionAccentAmber}"
                                BorderThickness="3,0,0,0" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnRescue" Style="{StaticResource GhostButton}" Height="34" MinWidth="140"
                                        IsEnabled="{Binding WipeCacheEnabled}" ToolTip="{Binding WipeCacheReason}" Click="BtnRescue_Click">
                                    <TextBlock><Run Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/><Run Text="   WIPE CACHE"/></TextBlock>
                                </Button>
                                <Button x:Name="BtnWipeData" Style="{StaticResource DangerButton}" Height="34" MinWidth="140" Margin="12,0,0,0"
                                        Click="BtnWipeData_Click"
                                        IsEnabled="{Binding FactoryWipeEnabled}" ToolTip="{Binding FactoryWipeReason}"
                                        AutomationProperties.Name="Factory wipe (erase userdata)">
                                    <TextBlock><Run Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"/><Run Text="   WIPE DATA"/></TextBlock>
                                </Button>
                                <Button x:Name="BtnFinish" Style="{StaticResource SuccessButton}" Height="34" MinWidth="160" Margin="12,0,0,0"
                                        Click="BtnFinish_Click" IsEnabled="{Binding FinishRebootEnabled}" ToolTip="{Binding FinishRebootReason}">
                                    <TextBlock><Run Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/><Run Text="   FINISH &amp; REBOOT"/></TextBlock>
                                </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Grid>

                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: LOGS -->
                <!-- TAB 3: DEVICE (4.1) -->
                <TabItem x:Name="TabDevice" Style="{StaticResource IndustrialTabItem}">
                <TabItem.Resources>
                    <SolidColorBrush x:Key="TabAccentBrush" Color="#3ECF8E"/>
                    <Color x:Key="TabAccentColor">#3ECF8E</Color>
                </TabItem.Resources>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="DEVICE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="24,20,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="DEVICE STATE" Style="{StaticResource TextPageTitle}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnRefreshDashboard" Style="{StaticResource GhostButton}" Height="32" MinWidth="130"
                                    FontSize="11" Margin="16,0,0,0" Content="REFRESH DETAILS"
                                    Click="BtnRefreshDashboard_Click"
                                    IsEnabled="{Binding DeviceDashboardRefreshEnabled}"
                                    ToolTip="{Binding DeviceDashboardRefreshReason}"/>
                            <TextBlock Text="{Binding DeviceDashboardRefreshReason}" Style="{StaticResource TextCaption}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{StaticResource SectionAccentGreen}"
                                    BorderThickness="3,0,0,0" CornerRadius="8" Padding="18,14"
                                    utils:Motion.FadeInOnShow="True">
                                <ItemsControl ItemsSource="{Binding DeviceDashboard}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                                           FontFamily="Consolas, Cascadia Code" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- RESCUE TOOLS: moved from the ADDITIONAL FILES tab —
                                 a stuck-device toolkit belongs on the state page. -->
                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource AccentRed}"
                                    BorderThickness="3,0,0,0" CornerRadius="8" Padding="18,14" Margin="0,16,0,0"
                                    utils:Motion.FadeInOnShow="True">
                                <StackPanel>
                                    <TextBlock Text="RESCUE TOOLS" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Small targeted repairs for a stuck device — hover any button for exactly what it touches."
                                               Style="{StaticResource TextCaption}" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button x:Name="BtnEraseFrp" Style="{StaticResource GhostButton}" Height="30" MinWidth="120"
                                                FontSize="11" Margin="0,0,8,8" Content="ERASE FRP"
                                                Click="BtnEraseFrp_Click"
                                                IsEnabled="{Binding EraseFrpEnabled}" ToolTip="{Binding EraseFrpReason}"/>
                                        <Button x:Name="BtnEraseMetadata" Style="{StaticResource GhostButton}" Height="30" MinWidth="120"
                                                FontSize="11" Margin="0,0,8,8" Content="WIPE METADATA"
                                                Click="BtnEraseMetadata_Click"
                                                IsEnabled="{Binding EraseMetadataEnabled}" ToolTip="{Binding EraseMetadataReason}"/>
                                        <Button x:Name="BtnEraseMisc" Style="{StaticResource GhostButton}" Height="30" MinWidth="120"
                                                FontSize="11" Margin="0,0,8,8" Content="ERASE MISC"
                                                Click="BtnEraseMisc_Click"
                                                IsEnabled="{Binding EraseMiscEnabled}" ToolTip="{Binding EraseMiscReason}"/>
                                        <Button x:Name="BtnSwitchSlot" Style="{StaticResource GhostButton}" Height="30" MinWidth="120"
                                                FontSize="11" Margin="0,0,8,8" Content="SWITCH SLOT"
                                                Click="BtnSwitchSlot_Click"
                                                IsEnabled="{Binding SwitchSlotEnabled}" ToolTip="{Binding SwitchSlotReason}"/>
                                        <Button x:Name="BtnBootFastbootd" Style="{StaticResource GhostButton}" Height="30" MinWidth="120"
                                                FontSize="11" Margin="0,0,8,8" Content="FASTBOOTD"
                                                Click="BtnBootFastbootd_Click"
                                                IsEnabled="{Binding BootFastbootdEnabled}" ToolTip="{Binding BootFastbootdReason}"/>
                                    </WrapPanel>
                                    <!-- Plain-language gloss of each tool, so the user never
                                         has to hover to know what a button touches. -->
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap" LineHeight="15">
                                        <Run Text="ERASE FRP" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/><Run Text=" — removes the Google account lock marker, for handing a device you own to someone else."/><LineBreak/>
                                        <Run Text="WIPE METADATA" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/><Run Text=" — erases the encryption keys; use when the phone is stuck encrypting or refuses to decrypt."/><LineBreak/>
                                        <Run Text="ERASE MISC" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/><Run Text=" — fixes a stuck recovery boot loop (bootloader booting recovery over and over)."/><LineBreak/>
                                        <Run Text="SWITCH SLOT" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/><Run Text=" — flips the active A/B slot; use when one slot keeps failing to boot."/><LineBreak/>
                                        <Run Text="FASTBOOTD" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/><Run Text=" — reboots into userspace fastboot, needed to touch dynamic partitions (system, vendor, product)."/>
                                    </TextBlock>
                                    <!-- Hard-brick disclaimer: destructive fastboot writes -->
                                    <Border Style="{StaticResource BannerWarn}" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentRed}"
                                                       TextWrapping="Wrap">
                                                <Run Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"/><Run Text="  WARNING — NO LIABILITY"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="These tools write directly to the device. A wrong or interrupted write can hard-brick the phone with no software fix. SR Flasher accepts no responsibility for hardware damage — use them only on a device you own, at your own risk."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabLogs" Style="{StaticResource IndustrialTabItem}">
                <TabItem.Resources>
                    <SolidColorBrush x:Key="TabAccentBrush" Color="#A78BFA"/>
                    <Color x:Key="TabAccentColor">#A78BFA</Color>
                </TabItem.Resources>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="LOGS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="24,20,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header + tools -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- C16: a wrapping row - at narrow widths the chips and
                                 buttons fold to a second line instead of overlapping. -->
                            <StackPanel Grid.ColumnSpan="3" VerticalAlignment="Center">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TextPageTitle}" Text="LOG OUTPUT" VerticalAlignment="Center"/>
                                    <TextBox Width="180" Margin="16,0,0,0" VerticalAlignment="Center"
                                             x:Name="LogSearchBox"
                                             Style="{StaticResource SearchTextBox}"
                                             Text="{Binding LogSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filter the log output shown below"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <RadioButton Content="ALL" GroupName="LogLevel" Style="{StaticResource ChipRadio}" IsChecked="True"
                                                     CommandParameter="All"
                                                     Tag="All" Checked="LogLevelChip_Checked"
                                                     ToolTip="Show every log line"/>
                                        <RadioButton Content="{Binding ErrorsChipText}" GroupName="LogLevel" Style="{StaticResource ChipRadio}"
                                                     Tag="Errors" Checked="LogLevelChip_Checked"
                                                     ToolTip="Show only [ERROR] lines"/>
                                        <RadioButton Content="{Binding WarningsChipText}" GroupName="LogLevel" Style="{StaticResource ChipRadio}"
                                                     Tag="Warnings" Checked="LogLevelChip_Checked"
                                                     ToolTip="Show warnings and errors"/>
                                        <ToggleButton x:Name="FollowToggle" Content="FOLLOW" FontSize="10"
                                                      IsChecked="{Binding FollowLogs, Mode=TwoWay}"
                                                      ToolTip="Keep the log scrolled to the newest line"
                                                      AutomationProperties.Name="Toggle log auto-follow"
                                                      Style="{StaticResource ChipToggle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Content="COPY ALL" Style="{StaticResource GhostButton}" Width="88" Height="26" FontSize="10" Padding="0" Margin="0,0,8,0"
                                                Click="MenuCopyAll_Click" ToolTip="Copy the whole log to the clipboard"/>
                                        <Button Content="OPEN FILE" Style="{StaticResource GhostButton}" Width="94" Height="26" FontSize="10" Padding="0" Margin="0,0,8,0"
                                                Click="BtnOpenLogs_Click" ToolTip="Open the current log file in Explorer"/>
                                        <Button Content="DIAGNOSTICS" Style="{StaticResource GhostButton}" Width="100" Height="26" FontSize="10" Padding="0" Margin="0,0,8,0"
                                                Click="BtnCopyDiagnostics_Click" ToolTip="Copy a support bundle: app version, device state, backups and the log tail"/>
                                        <Button Content="CLEAR" Style="{StaticResource GhostButton}" Width="70" Height="26" FontSize="10" Padding="0"
                                                Click="BtnClearLogs_Click" ToolTip="Clear the log view"/>
                                    </StackPanel>
                                </WrapPanel>
                                <!-- C25: point new users at the F1 overlay -->
                                <TextBlock Text="Full command output from adb and fastboot. Select lines and press Ctrl+C, or right-click to copy. F1 shows every shortcut."
                                           Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="LogList" Style="{StaticResource RoundedLogList}" ItemsSource="{Binding FilteredLogs}" Background="{DynamicResource ControlInputBg}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{StaticResource SectionAccentViolet}" BorderThickness="3,0,0,0" FontFamily="Consolas, Cascadia Code" FontSize="12" Padding="8"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <!-- The default ListBoxItem style forces a system-color
                                         foreground (black even in dark mode) — that made plain
                                         log lines unreadable on the dark log background. -->
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                                </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy Selected" Click="MenuCopySelected_Click" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="Copy All" Click="MenuCopyAll_Click"/>
                                <Separator/>
                                <MenuItem Header="Clear Logs" Click="BtnClearLogs_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="NoWrap" FontFamily="Consolas, Cascadia Code"
                                           Foreground="{Binding Converter={StaticResource LogColorConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>

                            <!-- Empty-state hint -->
                            <TextBlock Text="{Binding LogEmptyMessage}"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" TextAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=LogList}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- TAB 5: SETTINGS (3.7) -->
                <TabItem x:Name="TabSettings" Style="{StaticResource IndustrialTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="SETTINGS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Margin="24,20,24,28">

                            <!-- TOOLS: honest status of the three bundled binaries -->
                            <TextBlock Text="TOOLS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Bundled binaries — found on PATH or in the platform-tools folder:"
                                               Style="{StaticResource TextCaption}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="4"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="4"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="adb" FontFamily="Consolas, Cascadia Code" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                    <Setter Property="Text" Value="FOUND"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ToolAdbReady}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                            <Setter Property="Text" Value="NOT FOUND — flashing and device detection will not work"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="fastboot" FontFamily="Consolas, Cascadia Code" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                    <Setter Property="Text" Value="FOUND"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ToolFastbootReady}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                            <Setter Property="Text" Value="NOT FOUND — bootloader-mode operations will not work"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="payload-dumper-go" FontFamily="Consolas, Cascadia Code" FontSize="11"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                    <Setter Property="Text" Value="FOUND"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ToolDumperReady}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningAmber}"/>
                                                            <Setter Property="Text" Value="NOT FOUND — payload.bin ROMs cannot be unpacked (sideload zips still work)"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                </Grid>
                                </StackPanel>
                            </Border>

                            <!-- APPEARANCE -->
                            <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,18,0,8"/>
                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Theme — changes apply immediately" Style="{StaticResource TextCaption}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="DARK" GroupName="ThemeChip" Style="{StaticResource ChipRadio}"
                                                     IsChecked="{Binding IsThemeDark, Mode=TwoWay}" Click="ThemeChip_Click" Tag="Dark"
                                                     ToolTip="Deep charcoal surfaces with light text"/>
                                        <RadioButton Content="LIGHT" GroupName="ThemeChip" Style="{StaticResource ChipRadio}"
                                                     IsChecked="{Binding IsThemeLight, Mode=TwoWay}" Click="ThemeChip_Click" Tag="Light"
                                                     ToolTip="Bright surfaces, WCAG-checked colors"/>
                                        <RadioButton Content="OLED" GroupName="ThemeChip" Style="{StaticResource ChipRadio}"
                                                     IsChecked="{Binding IsThemeOled, Mode=TwoWay}" Click="ThemeChip_Click" Tag="Oled"
                                                     ToolTip="True black — ideal for OLED panels and dark rooms"/>
                                        <RadioButton Content="AUTO (WINDOWS)" GroupName="ThemeChip" Style="{StaticResource ChipRadio}"
                                                     IsChecked="{Binding IsThemeAuto, Mode=TwoWay}" Click="ThemeChip_Click" Tag="Auto"
                                                     ToolTip="Follow the Windows light/dark setting live"/>
                                    </StackPanel>
                                    <!-- A8 follow-through: user-facing motion gate.
                                         Divider + caption separate it from the theme chips. -->
                                    <Border Background="{DynamicResource BorderMedium}" Height="1" Margin="0,10,0,8" Opacity="0.4"/>
                                    <TextBlock Text="Motion" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                                    <CheckBox HorizontalContentAlignment="Left" Margin="0,0,0,0"
                                              Foreground="{DynamicResource TextPrimary}" FontSize="11"
                                              IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                                              ToolTip="Buttons and switches stay instant. Windows' own 'Animate controls' setting is honoured too.">
                                        <CheckBox.Content>
                                            <TextBlock Text="Reduce motion — skip the entrance fades and completion pop"
                                                       TextWrapping="Wrap"/>
                                        </CheckBox.Content>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- FLASHING -->
                            <TextBlock Text="FLASHING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,18,0,8"/>
                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Battery gate for flashing" Style="{StaticResource TextCaption}"/>
                                    <TextBlock Text="INSTALL ROM refuses to start while the battery is below this level — a mid-flash power loss is the worst failure there is."
                                               Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="BatteryThresholdSlider" Width="240" Minimum="0" Maximum="90"
                                                IsSnapToTickEnabled="True" TickFrequency="5"
                                                Value="{Binding BatteryThreshold, Mode=TwoWay}"
                                                ToolTip="Minimum battery percent for a ROM install"/>
                                        <TextBlock Text="{Binding BatteryThreshold, StringFormat={}{0}%}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkExpertModeSettings"
                                              FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                              IsChecked="{Binding IsExpertMode, Mode=TwoWay}"
                                              ToolTip="The same switch as the ADVANCED chips on the ROM tab">
                                        <CheckBox.Content>
                                            <TextBlock Text="Expert mode — shows per-partition selection, vbmeta verity options and the fastboot fallback route"
                                                       TextWrapping="Wrap"/>
                                        </CheckBox.Content>
                                    </CheckBox>
                                    <TextBlock Text="Keep OFF unless you know exactly why you need it — the guided route is the safe one."
                                               Style="{StaticResource TextCaption}" Margin="12,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- BACKUPS & LOGS -->
                            <TextBlock Text="BACKUPS &amp; LOGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,18,0,8"/>
                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Stock-recovery backups are stored per device under:" Style="{StaticResource TextCaption}"/>
                                    <TextBlock Text="{Binding BackupDirDisplay}" FontSize="11" FontFamily="Consolas, Cascadia Code"
                                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,8"
                                               ToolTip="{Binding BackupDirDisplay}"/>
                                    <Button x:Name="BtnSettingsOpenBackups" Style="{StaticResource GhostButton}" Height="30" FontSize="11"
                                            Padding="12,0" HorizontalAlignment="Left" Content="OPEN BACKUP FOLDER"
                                            Click="BtnOpenBackupsFolder_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Log retention" Style="{StaticResource TextCaption}"/>
                                    <TextBlock Text="Daily log files older than this are deleted at startup (crash logs are always kept)."
                                               Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider x:Name="LogRetentionSlider" Width="240" Minimum="7" Maximum="365"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                Value="{Binding LogRetentionDays, Mode=TwoWay}"
                                                ToolTip="Days of daily logs to keep (7-365)"/>
                                        <TextBlock Text="{Binding LogRetentionDays, StringFormat={}{0} days}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="OPEN FILE, DIAGNOSTICS and CLEAR live on the LOGS tab header."
                                               Style="{StaticResource TextCaption}" Margin="0,10,0,0"/>
                                    <TextBlock Text="Crash logs: %APPDATA%\SRFlasher\Logs\crash-*.log — never pruned."
                                               Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ABOUT -->
                            <TextBlock Text="ABOUT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,18,0,8"/>
                            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding AboutLogoPath}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="SR Flasher" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding AppVersionDisplay, StringFormat=Version {0}}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="ADB/fastboot must be on PATH or in the platform-tools folder. Logs live in %APPDATA%\SRFlasher\Logs."
                                                       FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Updates: auto-check once a day (toggleable),
                                         manual CHECK NOW always goes online. -->
                                    <Border Background="{DynamicResource BorderMedium}" Height="1" Margin="0,12,0,8" Opacity="0.4"/>
                                    <CheckBox HorizontalContentAlignment="Left" Margin="0,0,0,6"
                                              Foreground="{DynamicResource TextPrimary}" FontSize="11"
                                              IsChecked="{Binding CheckUpdates, Mode=TwoWay}"
                                              ToolTip="Queries the GitHub releases API at most once a day. No device data is sent — it is a plain version check.">
                                        <CheckBox.Content>
                                            <TextBlock Text="Check for updates automatically (once a day)"
                                                       TextWrapping="Wrap"/>
                                        </CheckBox.Content>
                                    </CheckBox>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <Button x:Name="BtnCheckUpdates" Style="{StaticResource GhostButton}" Height="30" FontSize="11"
                                                Padding="12,0" Content="CHECK FOR UPDATES"
                                                Click="BtnCheckUpdates_Click"/>
                                        <Button x:Name="BtnOpenReleases" Style="{StaticResource GhostButton}" Height="30" FontSize="11"
                                                Padding="12,0" Margin="8,0,0,0" Content="OPEN RELEASES PAGE"
                                                Visibility="{Binding UpdateAvailableVisibility}"
                                                Click="BtnOpenReleases_Click"
                                                ToolTip="Opens the GitHub releases page where the portable zip is published"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UpdateStatusText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- FLASH OVERLAY: while an operation is running, the tab content is
                 covered so nothing can be clicked mid-flash (also hides the step
                 trail above). The footer keeps the progress bar/ABORT below. -->
            <Border Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="40"
                    Background="{DynamicResource PanelBackground}" Opacity="0.96"
                    Visibility="{Binding FlashOverlayVisibility}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="FLASHING IN PROGRESS" Foreground="{DynamicResource TextPrimary}"
                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <!-- Transfer diagram: laptop sends, the phone fills with
                         the install percentage. The cable is a solid line
                         touching both shells; a bright pulse travels along it
                         while data moves. -->
                    <Grid Width="320" Height="120" Margin="0,18,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- Laptop (vertically centered like the phone) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,-8,0">
                            <!-- Body right-aligned so its edge physically meets the
                                 cable start — centered left a visible gap. -->
                            <Border Width="72" Height="48" CornerRadius="4,4,0,0" HorizontalAlignment="Right"
                                    Background="{DynamicResource ControlInputBg}"
                                    BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1.5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Height="4" Margin="8,0,8,4" CornerRadius="1"
                                            Background="{DynamicResource AccentRed}" Opacity="0.8"/>
                                </Grid>
                            </Border>
                            <Border Width="84" Height="6" CornerRadius="2,2,3,3" Margin="0,2,0,0"
                                    Background="{DynamicResource BorderMedium}"/>
                        </StackPanel>

                        <!-- Solid cable between the two shells -->
                        <Line Grid.Column="1" X1="0" Y1="0" X2="100" Y2="0"
                              VerticalAlignment="Center"
                              Stretch="Fill"
                              Stroke="{DynamicResource AccentRed}" StrokeThickness="2"/>
                        <!-- Data pulse riding the cable toward the phone -->
                        <Ellipse Grid.Column="1" Width="7" Height="7" Fill="#FF6B81"
                                 VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="CablePulse"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="CablePulse"
                                                             Storyboard.TargetProperty="X"
                                                             From="0" To="182" Duration="0:0:1.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" AutoReverse="True" Duration="0:0:0.55"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- Phone (vertically centered like the laptop) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="-8,0,0,0">
                            <Border Width="40" Height="78" CornerRadius="8"
                                    Background="{DynamicResource ControlInputBg}"
                                    BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1.5"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- Earpiece/notch -->
                                    <Border Grid.Row="0" Width="12" Height="3" CornerRadius="1.5"
                                            HorizontalAlignment="Center" Margin="0,4,0,0"
                                            Background="{DynamicResource BorderMedium}"/>
                                    <!-- Fill level: height tracks the smoothed progress -->
                                    <Border Grid.Row="1" VerticalAlignment="Bottom"
                                            CornerRadius="0,0,6,6"
                                            Height="{Binding ProgressValue, Converter={StaticResource PhoneFill}}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E0244A" Offset="0"/>
                                                <GradientStop Color="#FF6B81" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- Detected device's brand logo on the phone screen,
                                         above the rising fill -->
                                    <Image Grid.RowSpan="2" Source="{Binding DeviceLogoImage}" Visibility="{Binding DeviceLogoVisibility}"
                                           MaxWidth="26" MaxHeight="16" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           AutomationProperties.Name="Device brand logo"/>
                            </Grid>
                            </Border>
                            <!-- Ground shadow line -->
                            <Border Width="52" Height="3" CornerRadius="1.5" Margin="0,2,0,0"
                                    Background="{DynamicResource BorderMedium}" Opacity="0.6"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Do not unplug the device. The footer below shows live progress."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,12,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <Button Content="ABORT" Style="{StaticResource DangerButton}"
                            Height="28" FontSize="11" Padding="18,0" Margin="0,16,0,0"
                            HorizontalAlignment="Center" Click="BtnAbort_Click"
                            IsEnabled="{Binding FooterAbortEnabled}"
                            ToolTip="Cancel the running operation"/>
                </StackPanel>
            </Border>
            <!-- FLASHING PROGRESS PANEL -->
            <Grid x:Name="FlashingProgressPanel" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="50" Visibility="{Binding FlashProgressVisibility}" VerticalAlignment="Bottom">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                        </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        </Trigger>
                                        </Style.Triggers>
                                        </Style>
                                        </Grid.Style>
                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="0,1,0,0" Padding="24,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="StatusText" Text="{Binding ProgressText}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressText}"/>

                        <!-- Percent, elapsed and Abort on the right: a grid so the
                             baselines align and the percent value never jiggles
                             the row when it grows (9% -> 100%) -->
                        <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource TextHeading}" x:Name="PercentageText"
                                       Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                                       MinWidth="40" TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="ElapsedText" Text="{Binding ProgressElapsed}"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                       FontWeight="Bold"
                                       Margin="10,0,12,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" x:Name="FooterAbort" Content="ABORT" Style="{StaticResource DangerButton}"
                                    Height="26" FontSize="10" Padding="14,0" Click="BtnAbort_Click"
                                    IsEnabled="{Binding FooterAbortEnabled}" VerticalAlignment="Center"
                                    ToolTip="Cancel the running operation"
                                    AutomationProperties.Name="Abort the running operation"/>
                        </Grid>

                        <!-- Pipeline phases: CHECKS -> WRITE -> VERIFY -> REBOOT -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,5,0" CornerRadius="4" BorderThickness="1" Padding="0,4"
                                   RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ControlInputBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FlashPhaseChecks}" Value="Active">
                                                <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1.12" Duration="0:0:0.09" AutoReverse="True"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1.12" Duration="0:0:0.09" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FlashPhaseChecks}" Value="Done">
                                                <Setter Property="Background" Value="#1A00B894"/>
                                                <Setter Property="BorderBrush" Value="#5500B894"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="CHECKS" FontSize="9" FontWeight="Bold" TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FlashPhaseChecks}" Value="Active">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FlashPhaseChecks}" Value="Done">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <Border Grid.Column="1" Margin="0,0,5,0" CornerRadius="4" BorderThickness="1" Padding="0,4"
                                   RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ControlInputBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FlashPhaseWrite}" Value="Active">
                                                <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1.12" Duration="0:0:0.09" AutoReverse="True"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1.12" Duration="0:0:0.09" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FlashPhaseWrite}" Value="Done">
                                                <Setter Property="Background" Value="#1A00B894"/>
                                                <Setter Property="BorderBrush" Value="#5500B894"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FlashPhaseWriteLabel}" FontSize="9" FontWeight="Bold" TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FlashPhaseWrite}" Value="Active">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FlashPhaseWrite}" Value="Done">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <Border Grid.Column="2" Margin="0,0,5,0" CornerRadius="4" BorderThickness="1" Padding="0,4"
                                   RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ControlInputBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FlashPhaseVerify}" Value="Active">
                                                <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1.12" Duration="0:0:0.09" AutoReverse="True"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1.12" Duration="0:0:0.09" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FlashPhaseVerify}" Value="Done">
                                                <Setter Property="Background" Value="#1A00B894"/>
                                                <Setter Property="BorderBrush" Value="#5500B894"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="VERIFY" FontSize="9" FontWeight="Bold" TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FlashPhaseVerify}" Value="Active">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FlashPhaseVerify}" Value="Done">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <Border Grid.Column="3" CornerRadius="4" BorderThickness="1" Padding="0,4"
                                   RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ControlInputBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FlashPhaseReboot}" Value="Active">
                                                <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1.12" Duration="0:0:0.09" AutoReverse="True"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1.12" Duration="0:0:0.09" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FlashPhaseReboot}" Value="Done">
                                                <Setter Property="Background" Value="#1A00B894"/>
                                                <Setter Property="BorderBrush" Value="#5500B894"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="REBOOT" FontSize="9" FontWeight="Bold" TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FlashPhaseReboot}" Value="Active">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding FlashPhaseReboot}" Value="Done">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- Main Progress Bar: flat fill; the fill narrows and turns
                             brighter while a phase runs without measurable progress. -->
                        <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MainProgressBar" Height="12" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressValue}" VerticalAlignment="Center" Background="{DynamicResource ControlInputBg}" BorderThickness="0"
                                     IsIndeterminate="{Binding FlashBarIndeterminate, Mode=OneWay}">
                            <ProgressBar.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E0244A" Offset="0.0"/>
                                    <GradientStop Color="#C41E3F" Offset="1.0"/>
                                </LinearGradientBrush>
                            </ProgressBar.Foreground>
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <Grid x:Name="PART_Track" ClipToBounds="True">
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                    Background="{TemplateBinding Foreground}" CornerRadius="6"
                                                    ClipToBounds="True">
                                                <!-- Beaming sweep while a flash runs: a soft
                                                     white band glides across the fill forever. -->
                                                <Border x:Name="PART_Shine" Visibility="Hidden">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="ShineStoryboard">
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[0].Offset"
                                                                                                 From="-0.6" To="1.4" Duration="0:0:1.3"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].Offset"
                                                                                                 From="-0.4" To="1.6" Duration="0:0:1.3"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[2].Offset"
                                                                                                 From="-0.2" To="1.8" Duration="0:0:1.3"/>
                                                                            </Storyboard>
                                                                            </BeginStoryboard>
                                                                            </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="ShineStoryboard"/>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="Transparent" Offset="-0.6"/>
                                                            <GradientStop Color="#59FFFFFF" Offset="-0.4"/>
                                                            <GradientStop Color="Transparent" Offset="-0.2"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsIndeterminate" Value="True">
                                            <Setter TargetName="PART_Indicator" Property="Width" Value="110"/>
                                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Center"/>
                                            <Setter TargetName="PART_Indicator" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#E0244A" Offset="0.0"/>
                                                        <GradientStop Color="#FF6B81" Offset="0.5"/>
                                                        <GradientStop Color="#E0244A" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.65" Duration="0:0:0.7" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </Grid>
                </Border>
            </Grid>
            </Grid>

            <!-- TOAST NOTIFICATIONS: cross-tab outcome notices. Auto-dismissing
                 info/success toasts and sticky failures (max three visible).
                 Overlays the content column so a toast never re-flows it. -->
            <ItemsControl x:Name="ToastHost" Grid.Column="1" Grid.Row="0" Width="320"
                          Margin="0,56,12,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                          IsHitTestVisible="True" Panel.ZIndex="50"
                          Visibility="{Binding ToastsVisibility}"
                          ItemsSource="{Binding Toasts}"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Margin="0,0,0,8" Padding="12"
                                BorderThickness="1"
                                RenderTransformOrigin="1,0.5"
                                Background="{DynamicResource PanelBackground}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ToastSlide"/>
                            </Border.RenderTransform>
                            <!-- Entrance and exit are driven from code-behind
                                 through Utilities.Motion (ToastIn/ToastOut) so the
                                 reduce-motion setting is honoured. -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderMedium}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                                            <Setter Property="BorderBrush" Value="#5500B894"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Top" Margin="0,2,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                        Padding="0" Width="22" Height="22" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top"
                                        Click="ToastDismiss_Click"
                                        ToolTip="Dismiss"
                                        AutomationProperties.Name="Dismiss notification"/>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- KEYBOARD SHORTCUTS OVERLAY (G5): toggled with F1 or "?" -->
            <Grid x:Name="ShortcutsOverlay" Grid.Row="0" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#C8000000">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24"
                        Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderMedium}"
                        BorderThickness="1" Padding="24" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextPageTitle}" Text="KEYBOARD SHORTCUTS" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource TextCaption}" Text="Press F1 or ESC to close" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimary}" LineHeight="22">
                            <Run Text="Ctrl+O" FontWeight="Bold"/><Run Text="   Browse for a ROM package"/>
                            <LineBreak/>
                            <Run Text="Ctrl+F" FontWeight="Bold"/><Run Text="   Start the flash (when enabled)"/>
                            <LineBreak/>
                            <Run Text="Ctrl+C" FontWeight="Bold"/><Run Text="   Copy the selected log lines"/>
                            <LineBreak/>
                            <Run Text="F5" FontWeight="Bold"/><Run Text="        Refresh the device state"/>
                            <LineBreak/>
                            <Run Text="F1" FontWeight="Bold"/><Run Text="        Toggle this overlay"/>
                            <LineBreak/>
                            <Run Text="Double-click path" FontWeight="Bold"/><Run Text="   Copy the ROM path"/>
                        </TextBlock>
                        <Button Content="CLOSE" Style="{StaticResource GhostButton}" Width="120" Height="32"
                                HorizontalAlignment="Center" Margin="0,16,0,0" Click="BtnCloseShortcuts_Click"
                                AutomationProperties.Name="Close the shortcuts overlay"/>
                        </StackPanel>
                </Border>
            </Grid>

            <!-- IDLE FOOTER BAR: moved into the sidebar (docked below RECENT)
                 so it can no longer overlap it. -->

        <!-- ==================== WELCOME PAGE ====================
             The app opens on this full-width view showing only the device
             status. When a device connects it asks what to do today; picking
             FLASH A ROM / FLASH FILES morphs the page into the expanded
             sidebar and reveals the matching tab. -->
        <Grid x:Name="WelcomePage" Grid.ColumnSpan="2" Panel.ZIndex="60"
              Background="{DynamicResource WindowBackground}"
              Visibility="{Binding WelcomeVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.9*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Welcome title: brand flasher logo below "Welcome to" -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock Text="Welcome to" FontSize="22"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                <Image Source="{Binding WelcomeLogoImage}" Width="96" Height="96"
                       Margin="0,16,0,10" HorizontalAlignment="Center"
                       AutomationProperties.Name="Flasher"/>
            </StackPanel>

            <!-- Device status card -->
            <Border Grid.Row="2" MaxWidth="480" HorizontalAlignment="Center" Margin="24,30,24,0"
                    CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderMedium}"
                    Background="{DynamicResource PanelBackground}" Padding="26,20">
                <StackPanel>
                    <!-- No device yet -->
                    <StackPanel Visibility="{Binding WelcomeNoDeviceVisibility}" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="10" Height="10" Style="{StaticResource LedDotStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text="NO DEVICE CONNECTED" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Connect your phone via USB and allow USB debugging to begin."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,10,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                    <!-- Device connected: mirrors the expanded sidebar's card -->
                    <StackPanel Visibility="{Binding WelcomeDeviceVisibility}">
                        <!-- Hero: brand-color ring badge + name + connection LED -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Letter ring badge (hidden when a brand logo is available) -->
                                <Grid Width="52" Height="52" VerticalAlignment="Center"
                                      Visibility="{Binding DeviceBadgeVisibility}">
                                    <Ellipse Width="52" Height="52" Fill="{Binding DeviceBadgeBrush}" Opacity="0.16"/>
                                    <Border Width="46" Height="46" CornerRadius="23" BorderBrush="{Binding DeviceBadgeBrush}" BorderThickness="2">
                                        <TextBlock Text="{Binding DeviceBadgeLetter}" FontSize="16" FontWeight="Bold" Foreground="{Binding DeviceBadgeBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    </Grid>
                                <!-- Brand logo (Logos\Brand.png next to the exe), shown on a mini phone screen -->
                                <Border Style="{StaticResource PhoneLogoFrame}" Visibility="{Binding DeviceLogoVisibility}"
                                        AutomationProperties.Name="Device brand logo">
                                    <Image Source="{Binding DeviceLogoImage}" MaxWidth="24" MaxHeight="18"
                                           Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TextPageTitle}" Text="{Binding DeviceName}" TextWrapping="Wrap" MaxWidth="260"/>
                                    <TextBlock Style="{StaticResource TextBadge}" Text="{Binding DeviceCodename}" TextWrapping="Wrap" MaxWidth="260"/>
                                </StackPanel>
                            </StackPanel>
                            <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource LedDotStyle}"
                                     ToolTip="Device connection status"/>
                        </Grid>

                        <Border Background="{DynamicResource BorderMedium}" Height="1" Margin="0,8,0,8" Opacity="0.4"/>

                        <!-- One-line summary: mode -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DeviceModeDisplay}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Bootloader chip stays visible: it is the safety-critical value -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="BOOTLOADER" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Grid>
                                <Border CornerRadius="10" Background="{Binding DeviceBootloaderBrush}" Opacity="0.16" Padding="8,4"/>
                                <TextBlock Text="{Binding DeviceBootloaderState}" Foreground="{Binding DeviceBootloaderBrush}" FontSize="11" FontWeight="Bold" Padding="8,4" VerticalAlignment="Center"/>
                        </Grid>
                        </StackPanel>

                        <!-- Everything else folds into DETAILS -->
                        <Expander Margin="0,10,0,0" HorizontalAlignment="Center" MinWidth="300">
                            <Expander.Header>
                                <TextBlock Text="DEVICE DETAILS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                            </Expander.Header>
                            <StackPanel HorizontalAlignment="Center" MinWidth="300">

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="ANDROID" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DeviceAndroidDisplay}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource TextBadge}" Text="{Binding DeviceSecurityPatch}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="BATTERY" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ProgressBar Width="44" Height="6" Minimum="0" Maximum="100" Value="{Binding DeviceBatteryLevel, Mode=OneWay}"
                                                     Background="{DynamicResource BorderMedium}" BorderThickness="0" Foreground="{Binding DeviceBatteryBarBrush}"
                                                     Visibility="{Binding DeviceBatteryBarVisibility}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DeviceBatteryDisplay}" Margin="8,0,0,0" Foreground="{Binding DeviceBatteryBrush}" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="72"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="ACTIVE SLOT" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Grid>
                                        <Border CornerRadius="10" Background="{DynamicResource BorderMedium}" Opacity="0.55" Padding="8,4"/>
                                        <TextBlock Text="{Binding DeviceSlotDisplay}" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" Padding="8,4" VerticalAlignment="Center"
                                                   MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="SERIAL" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding DeviceSerialDisplay}" VerticalAlignment="Center"
                                               MaxWidth="86" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceSerialDisplay}"/>
                                    <Button x:Name="WelcomeBtnCopySerial" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                            Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}" Click="BtnCopySerial_Click"
                                            ToolTip="Copy the serial number (for support posts)"
                                            AutomationProperties.Name="Copy device serial"/>
                                </StackPanel>

                                <!-- Anti-rollback (Xiaomi/HyperOS; visible only when the device reports it) -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding DeviceAntiVisibility}">
                                    <TextBlock Text="ANTI-ROLLBACK" Width="92" Foreground="{DynamicResource TextSecondary}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Grid>
                                        <Border CornerRadius="10" Background="{DynamicResource DangerTintBg}" Padding="8,4"/>
                                        <TextBlock Text="{Binding DeviceAntiDisplay}" Foreground="{Binding DeviceAntiBrush}" FontSize="11" FontWeight="Bold" Padding="8,4" VerticalAlignment="Center"
                                                   MaxWidth="110" TextTrimming="CharacterEllipsis"
                                                   ToolTip="Flashing firmware older than this anti version may permanently brick the device"/>
                                </Grid>
                                </StackPanel>

                                <TextBlock Text="{Binding DeviceLastSeen}" Foreground="{DynamicResource WarningAmber}" FontSize="10" Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>

                            </StackPanel>
                        </Expander>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- The choice -->
            <TextBlock Grid.Row="3" Text="What do you want to do today?" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,36,0,18"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="WelcomeBtnRom" Content="FLASH A ROM" Height="46" FontSize="14" Width="196"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding DeviceConnected}"
                        Click="WelcomeBtnRom_Click" AutomationProperties.Name="Flash a ROM"
                        ToolTip="Install a full ROM package — the app reboots the device itself. Connect a phone to enable."/>
                <Button x:Name="WelcomeBtnFiles" Content="FLASH FILES" Height="46" FontSize="14" Width="196"
                        Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                        IsEnabled="{Binding DeviceConnected}"
                        Click="WelcomeBtnFiles_Click" AutomationProperties.Name="Flash additional files"
                        ToolTip="Flash GAPPS, Magisk, kernels and other add-on packages. Connect a phone to enable."/>
            </StackPanel>

            <!-- Escape hatch -->
            <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,0,0,18">
                <TextBlock Text="Everything runs locally through fastboot and adb — nothing is uploaded."
                           Foreground="{DynamicResource TextSecondary}" FontSize="10" Opacity="0.7"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <Button x:Name="WelcomeBtnSkip" Content="SKIP" Height="30" FontSize="11" Padding="22,0"
                        Style="{StaticResource GhostButton}" HorizontalAlignment="Center"
                        Click="WelcomeBtnSkip_Click" AutomationProperties.Name="Skip and open the full app"
                        ToolTip="Open the full app without a device connected"/>
            </StackPanel>


            </Grid>
        </Grid>
</Window>
