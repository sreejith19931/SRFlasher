<Application x:Class="SRFlasher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SRFlasher"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SlimScrollbars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- App-level button chrome: code-built popups (themed confirm,
                 guidance and abort dialogs) resolve these styles through the
                 application resources, so every popup matches the theme. -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="PressRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <!-- A5: the press feels like a key, not a click. -->
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" Background="{DynamicResource ControlInputBg}" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" CornerRadius="9"/>
                            <Border x:Name="HoverVeil" Background="{DynamicResource HoverVeilSoft}" CornerRadius="9" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="1"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnDisabledBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger: red outline, static glow on hover only (no idle animation). -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="PressRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" Background="{DynamicResource DangerBg}" BorderBrush="{DynamicResource DangerRed}" BorderThickness="1" CornerRadius="9"/>
                            <Border x:Name="Glow" Background="Transparent" BorderBrush="{DynamicResource DangerRed}" BorderThickness="1.5" CornerRadius="9" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#E74C3C" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PressRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Declared after the hover trigger so a disabled button
                                 never picks up the glow. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BtnDisabledBg}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
