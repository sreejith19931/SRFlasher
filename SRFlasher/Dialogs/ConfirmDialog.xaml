<Window x:Class="SRFlasher.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Local button chrome: the MainWindow button styles are window-scoped,
             so the dialog carries its own themed pair. -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{DynamicResource ControlInputBg}"
                                    BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" CornerRadius="9"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{DynamicResource DangerBg}"
                                    BorderBrush="{DynamicResource DangerRed}" BorderThickness="1" CornerRadius="9"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1">
        <Grid Width="460">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header doubles as the drag handle (the window has no chrome). -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBackground}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <TextBlock x:Name="TitleText" Text="Confirm"
                               Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,32,0" TextTrimming="CharacterEllipsis"/>
                    <Button Content="✕" Style="{StaticResource DialogButton}" Width="26" Height="24"
                            MinWidth="0" Padding="0" FontSize="10"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Cancel_Click" ToolTip="Cancel"/>
                </Grid>
            </Border>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="20,14,20,2"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,14">
                <!-- Enter and Esc both cancel; confirming always takes a click. -->
                <Button x:Name="CancelButton" Content="No" Style="{StaticResource DialogButton}"
                        IsCancel="True" IsDefault="True" Margin="0,0,10,0"/>
                <Button x:Name="ConfirmButton" Content="Yes" Style="{StaticResource DialogDangerButton}"
                        Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
