<Window x:Class="SRFlasher.Dialogs.SideloadGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply via ADB"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{DynamicResource ControlInputBg}"
                                    BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" CornerRadius="9"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="24,18" BorderBrush="{DynamicResource BorderMedium}" BorderThickness="1" CornerRadius="10">
        <StackPanel MinWidth="380">
            <TextBlock x:Name="TitleText" Text="APPLY UPDATE VIA ADB" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Border Background="{DynamicResource BorderMedium}" Height="1" Margin="0,10,0,12" Opacity="0.4"/>

            <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                       Text="On the phone's recovery screen:"/>
            <StackPanel Margin="0,10,0,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimary}">
                    <Run Text="1.  " Foreground="{DynamicResource TextSecondary}"/><Run FontWeight="Bold" Text="Apply update"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0">
                    <Run Text="2.  " Foreground="{DynamicResource TextSecondary}"/><Run FontWeight="Bold" Text="Apply update via ADB"/>
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="3.  Keep the cable connected — the transfer starts automatically."/>
            </StackPanel>

            <Border Background="{DynamicResource ControlInputBg}" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                           Text="Waiting for the phone — tap 'Apply update via ADB' on it"/>
            </Border>

            <Button Style="{StaticResource DialogButton}" Content="CANCEL WAIT" HorizontalAlignment="Right"
                    Margin="0,14,0,0" Click="Cancel_Click"
                    ToolTip="Abort the wait — the phone stays in recovery and nothing is written"/>
        </StackPanel>
    </Border>
</Window>
